# =============================================================================
# HospitalUnicaes-Api: variables de entorno
# Copia este archivo a `.env` y completa los valores. `.env` NUNCA se sube al repo.
# Los valores salen de Supabase Dashboard > Project Settings (proyecto "Hospital UNICAES").
# =============================================================================

# --- Servidor -----------------------------------------------------------------
PORT=3000

# --- Base de datos (Prisma) ---------------------------------------------------
# Dashboard > Connect > ORMs > Prisma. Reemplaza [PASSWORD] por la contraseña de la BD.
# Conexión con pooler en modo transacción (puerto 6543): consultas de la app.
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión con pooler en modo sesión (puerto 5432): introspección (`prisma db pull`).
DIRECT_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# --- Supabase (API y Auth) ----------------------------------------------------
# Dashboard > Project Settings > API.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Llave pública (anon / publishable). Respeta RLS; es la misma que usan los clientes.
SUPABASE_ANON_KEY=""
# Llave de servicio (service_role / secret). SALTA RLS: solo en el backend,
# nunca en apps móviles, web, logs ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Supabase CLI (opcional) --------------------------------------------------
# Contraseña de la BD para `supabase link` / `supabase db push` sin prompt interactivo.
# La CLI la lee de esta variable de entorno; no la escribas en ningún archivo versionado.
SUPABASE_DB_PASSWORD=""
